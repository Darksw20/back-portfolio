{
  "name": "back-portfolio",
  "version": "0.1.0",
  "description": "Versioned API and database migrations for Ricardo Navarro's portfolio.",
  "type": "module",
  "private": true,
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/dev-server.ts",
    "seed": "tsx scripts/seed.ts",
    "test:session": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/session-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^2.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.2",
    "jose": "^6.2.4",
    "simple-icons": "16.36.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "24.x"
  }
}
